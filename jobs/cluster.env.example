# Site-specific configuration for the historical Linux/Slurm training route; see README.md.
# Copy this example to jobs/cluster.env and replace every placeholder before use.
# Resource values retain the recorded execution profile; confirm that your site permits these requests.
PROJECT_ROOT="<absolute_path_to_submission>"
MOLECULEACE_ENV="<absolute_path_to_dedicated_training_environment>"
CONDA_INIT="<absolute_path_to_conda_initialisation_script>"
PIP_CACHE_DIR="<absolute_path_to_pip_cache>"
CONDA_PKGS_DIRS="<absolute_path_to_conda_package_cache>"
PROTECTED_ENV="<absolute_path_to_environment_that_must_not_be_modified>"
CUDA_MODULE="<site_cuda_11_3_module>"

SLURM_GPU_DEBUG_PARTITION="<debug_gpu_partition>"
SLURM_GPU_DEBUG_QOS="<debug_gpu_qos>"
SLURM_GPU_DEBUG_TIME=02:00:00
SLURM_GPU_DEBUG_MAX_TIME=03:00:00
SLURM_GPU_DEBUG_MAX_JOBS=3
SLURM_GPU_DEBUG_CPUS=10
SLURM_GPU_DEBUG_MEM=64G

SLURM_GPU_PROD_ACCOUNT="<production_account>"
SLURM_GPU_PROD_PARTITION="<production_gpu_partition>"
SLURM_GPU_PROD_QOS="<production_gpu_qos>"
SLURM_GPU_PROD_EXCLUDE=""
SLURM_GPU_PROD_MAX_TIME=48:00:00
SLURM_GPU_PROD_MAX_JOBS=4
SLURM_GPU_PROD_MAX_CONCURRENT=2
SLURM_GPU_PROD_MAX_GPUS=4
SLURM_GPU_PROD_CPUS=10
SLURM_GPU_PROD_MEM=16G
SLURM_GPU_PROD_TIME=00:30:00
SLURM_GPU_WORKER_TIME=24:00:00
SLURM_GPU_WORKER_MEM=32G

SLURM_CPU_PARTITION="<cpu_partition>"
SLURM_CPU_QOS="<cpu_qos>"
SLURM_CPU_CPUS=4
SLURM_CPU_MEM=16G
SLURM_CPU_TIME=01:00:00
